BFL_API_KEY=
BFL_MODEL_ENDPOINT=https://api.bfl.ai/v1/flux-3-video
BFL_RESOLUTION=hd
BFL_CONCURRENCY=8
BFL_MODEL_VERSION=
WALL_RECENT_WINDOW=6
LOCAL_API_PORT=8788

# Optional: share films between several walls (one per Mac) through Supabase.
# Leave empty to run fully local. WALL_ID names this Mac in the shared tables
# and defaults to the hostname. With a shared BFL key, keep BFL_CONCURRENCY
# low per Mac (it defaults to 3 when sync is on).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=video-wall
WALL_ID=
